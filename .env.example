# Backend for the admin panel (Supabase).
#
# Copy this file to `.env.local` and fill in the two values from
# Supabase → Project Settings → API.
#
# .env.local is git-ignored: no credential is ever committed.
# Only the *anon / publishable* key belongs here — it is designed to be public
# and row-level security decides what it may do. NEVER use the service_role key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
